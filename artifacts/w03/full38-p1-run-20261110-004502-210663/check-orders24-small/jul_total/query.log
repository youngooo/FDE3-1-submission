  "sql": "WITH sma_10005_cte AS (\n  SELECT\n    DATE_TRUNC('day', ordered_at) AS metric_time__day\n    , CASE WHEN order_id IS NOT NULL THEN 1 ELSE 0 END AS __order_count\n    , CASE WHEN CASE WHEN status = 'paid' THEN order_id END IS NOT NULL THEN 1 ELSE 0 END AS __paid_order_count\n    , CASE WHEN CASE WHEN status = 'paid' AND paid_cents - refund_cents > 0 THEN order_id END IS NOT NULL THEN 1 ELSE 0 END AS __valid_order_count\n    , CASE WHEN CASE WHEN status = 'cancelled' THEN order_id END IS NOT NULL THEN 1 ELSE 0 END AS __cancelled_order_count\n    , CASE WHEN CASE WHEN status = 'paid' AND refund_cents > 0 THEN order_id END IS NOT NULL THEN 1 ELSE 0 END AS __refund_order_count\n    , CASE WHEN CASE WHEN status = 'paid' AND refund_cents > 0 AND refund_cents < paid_cents THEN order_id END IS NOT NULL THEN 1 ELSE 0 END AS __partial_refund_order_count\n    , CASE WHEN CASE WHEN status = 'paid' AND paid_cents > 0 AND refund_cents = paid_cents THEN order_id END IS NOT NULL THEN 1 ELSE 0 END AS __full_refund_order_count\n    , CASE WHEN status = 'paid' THEN paid_cents ELSE 0 END AS __payment_cents\n    , CASE WHEN status = 'paid' THEN refund_cents ELSE 0 END AS __refund_cents\n    , CASE WHEN status = 'paid' THEN paid_cents - refund_cents ELSE 0 END AS __net_sales_cents\n    , CASE WHEN status = 'paid' THEN gross_cents ELSE 0 END AS __gross_cents\n    , CASE WHEN status = 'paid' THEN gross_cents - paid_cents ELSE 0 END AS __discount_cents\n    , CASE WHEN status = 'paid' AND paid_cents - refund_cents > 0 THEN member_id END AS __buyer_count\n    , CASE WHEN status = 'paid' AND refund_cents > 0 THEN member_id END AS __refund_buyer_count\n    , CASE WHEN status = 'paid' AND paid_cents - refund_cents > 0 THEN store_id END AS __selling_store_count\n    , CASE WHEN status = 'paid' AND paid_cents - refund_cents > 0 THEN quantity ELSE 0 END AS __valid_order_items\n  FROM \"data\".\"main\".\"order_facts\" order_semantic_src_10000\n)\n\nSELECT\n  MAX(subq_22.order_count) AS order_count\n  , MAX(subq_22.paid_order_count) AS paid_order_count\n  , MAX(subq_22.valid_order_count) AS valid_order_count\n  , MAX(subq_22.cancelled_order_count) AS cancelled_order_count\n  , MAX(subq_22.refund_order_count) AS refund_order_count\n  , MAX(subq_22.partial_refund_order_count) AS partial_refund_order_count\n  , MAX(subq_22.full_refund_order_count) AS full_refund_order_count\n  , MAX(subq_22.payment_cents) AS payment_cents\n  , MAX(subq_22.refund_cents) AS refund_cents\n  , MAX(subq_22.net_sales_cents) AS net_sales_cents\n  , MAX(subq_22.gross_cents) AS gross_cents\n  , MAX(subq_22.discount_cents) AS discount_cents\n  , MAX(subq_22.buyer_count) AS buyer_count\n  , MAX(subq_22.refund_buyer_count) AS refund_buyer_count\n  , MAX(subq_22.selling_store_count) AS selling_store_count\n  , MAX(subq_22.valid_order_items) AS valid_order_items\n  , MAX(subq_29.avg_order_value) AS avg_order_value\n  , MAX(subq_29.avg_buyer_value) AS avg_buyer_value\n  , MAX(subq_29.purchase_frequency) AS purchase_frequency\n  , MAX(subq_29.refund_amount_rate) AS refund_amount_rate\n  , MAX(subq_29.cancel_rate) AS cancel_rate\n  , MAX(subq_29.refund_order_rate) AS refund_order_rate\n  , MAX(subq_29.discount_rate) AS discount_rate\n  , MAX(subq_29.items_per_order) AS items_per_order\nFROM (\n  SELECT\n    SUM(__order_count) AS order_count\n    , SUM(__paid_order_count) AS paid_order_count\n    , SUM(__valid_order_count) AS valid_order_count\n    , SUM(__cancelled_order_count) AS cancelled_order_count\n    , SUM(__refund_order_count) AS refund_order_count\n    , SUM(__partial_refund_order_count) AS partial_refund_order_count\n    , SUM(__full_refund_order_count) AS full_refund_order_count\n    , SUM(__payment_cents) AS payment_cents\n    , SUM(__refund_cents) AS refund_cents\n    , SUM(__net_sales_cents) AS net_sales_cents\n    , SUM(__gross_cents) AS gross_cents\n    , SUM(__discount_cents) AS discount_cents\n    , COUNT(DISTINCT __buyer_count) AS buyer_count\n    , COUNT(DISTINCT __refund_buyer_count) AS refund_buyer_count\n    , COUNT(DISTINCT __selling_store_count) AS selling_store_count\n    , SUM(__valid_order_items) AS valid_order_items\n  FROM sma_10005_cte\n  WHERE metric_time__day BETWEEN '2026-07-01' AND '2026-07-31'\n) subq_22\nCROSS JOIN (\n  SELECT\n    CAST(SUM(__net_sales_cents) AS DOUBLE) / CAST(NULLIF(SUM(__valid_order_count), 0) AS DOUBLE) AS avg_order_value\n    , CAST(SUM(__net_sales_cents) AS DOUBLE) / CAST(NULLIF(COUNT(DISTINCT __buyer_count), 0) AS DOUBLE) AS avg_buyer_value\n    , CAST(SUM(__valid_order_count) AS DOUBLE) / CAST(NULLIF(COUNT(DISTINCT __buyer_count), 0) AS DOUBLE) AS purchase_frequency\n    , CAST(SUM(__refund_cents) AS DOUBLE) / CAST(NULLIF(SUM(__payment_cents), 0) AS DOUBLE) AS refund_amount_rate\n    , CAST(SUM(__cancelled_order_count) AS DOUBLE) / CAST(NULLIF(SUM(__order_count), 0) AS DOUBLE) AS cancel_rate\n    , CAST(SUM(__refund_order_count) AS DOUBLE) / CAST(NULLIF(SUM(__paid_order_count), 0) AS DOUBLE) AS refund_order_rate\n    , CAST(SUM(__discount_cents) AS DOUBLE) / CAST(NULLIF(SUM(__gross_cents), 0) AS DOUBLE) AS discount_rate\n    , CAST(SUM(__valid_order_items) AS DOUBLE) / CAST(NULLIF(SUM(__valid_order_count), 0) AS DOUBLE) AS items_per_order\n  FROM sma_10005_cte\n  WHERE metric_time__day BETWEEN '2026-07-01' AND '2026-07-31'\n) subq_29",

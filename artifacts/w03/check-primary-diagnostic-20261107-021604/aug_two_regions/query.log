  "sql": "SELECT\n  member_home_store_dim_src_10000.region AS home_store__region\n  , order_store_dim_src_10000.region AS store__region\n  , SUM(subq_18.__order_count) AS order_count\n  , SUM(subq_18.__paid_order_count) AS paid_order_count\n  , SUM(subq_18.__valid_order_count) AS valid_order_count\n  , SUM(subq_18.__cancelled_order_count) AS cancelled_order_count\n  , SUM(subq_18.__refund_order_count) AS refund_order_count\n  , SUM(subq_18.__partial_refund_order_count) AS partial_refund_order_count\n  , SUM(subq_18.__full_refund_order_count) AS full_refund_order_count\n  , SUM(subq_18.__payment_cents) AS payment_cents\n  , SUM(subq_18.__refund_cents) AS refund_cents\n  , SUM(subq_18.__net_sales_cents) AS net_sales_cents\n  , SUM(subq_18.__gross_cents) AS gross_cents\n  , SUM(subq_18.__discount_cents) AS discount_cents\n  , COUNT(DISTINCT subq_18.__buyer_count) AS buyer_count\n  , COUNT(DISTINCT subq_18.__refund_buyer_count) AS refund_buyer_count\n  , COUNT(DISTINCT subq_18.__selling_store_count) AS selling_store_count\n  , SUM(subq_18.__valid_order_items) AS valid_order_items\nFROM (\n  SELECT\n    store_id AS store\n    , home_store_id AS home_store\n    , CASE WHEN order_id IS NOT NULL THEN 1 ELSE 0 END AS __order_count\n    , CASE WHEN status = 'paid' THEN 1 ELSE 0 END AS __paid_order_count\n    , CASE WHEN status = 'paid' AND paid_cents > refund_cents THEN 1 ELSE 0 END AS __valid_order_count\n    , CASE WHEN status = 'cancelled' THEN 1 ELSE 0 END AS __cancelled_order_count\n    , CASE WHEN status = 'paid' AND refund_cents > 0 THEN 1 ELSE 0 END AS __refund_order_count\n    , CASE WHEN status = 'paid' AND refund_cents > 0 AND refund_cents < paid_cents THEN 1 ELSE 0 END AS __partial_refund_order_count\n    , CASE WHEN status = 'paid' AND paid_cents > 0 AND refund_cents = paid_cents THEN 1 ELSE 0 END AS __full_refund_order_count\n    , CASE WHEN status = 'paid' THEN paid_cents ELSE 0 END AS __payment_cents\n    , CASE WHEN status = 'paid' THEN refund_cents ELSE 0 END AS __refund_cents\n    , CASE WHEN status = 'paid' THEN paid_cents - refund_cents ELSE 0 END AS __net_sales_cents\n    , CASE WHEN status = 'paid' THEN gross_cents ELSE 0 END AS __gross_cents\n    , CASE WHEN status = 'paid' THEN gross_cents - paid_cents ELSE 0 END AS __discount_cents\n    , CASE WHEN status = 'paid' AND paid_cents > refund_cents THEN member_id ELSE NULL END AS __buyer_count\n    , CASE WHEN status = 'paid' AND refund_cents > 0 THEN member_id ELSE NULL END AS __refund_buyer_count\n    , CASE WHEN status = 'paid' AND paid_cents > refund_cents THEN store_id ELSE NULL END AS __selling_store_count\n    , CASE WHEN status = 'paid' AND paid_cents > refund_cents THEN quantity ELSE 0 END AS __valid_order_items\n  FROM \"data\".\"main\".\"order_facts\" order_facts_src_10000\n  WHERE DATE_TRUNC('day', ordered_at) BETWEEN '2026-08-01' AND '2026-08-31'\n) subq_18\nLEFT OUTER JOIN\n  \"data\".\"main\".\"member_home_store_dim\" member_home_store_dim_src_10000\nON\n  subq_18.home_store = member_home_store_dim_src_10000.home_store_id\nLEFT OUTER JOIN\n  \"data\".\"main\".\"order_store_dim\" order_store_dim_src_10000\nON\n  subq_18.store = order_store_dim_src_10000.store_id\nGROUP BY\n  member_home_store_dim_src_10000.region\n  , order_store_dim_src_10000.region",

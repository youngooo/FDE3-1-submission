        "sql": "WITH sma_10003_cte AS (\n  SELECT\n    DATE_TRUNC('day', ordered_at) AS metric_time__day\n    , status AS order__status\n    , 1 AS __order_count\n    , CASE WHEN status = 'paid' AND paid_cents - refund_cents > 0 THEN 1 ELSE 0 END AS __valid_order_count\n    , CASE WHEN status = 'cancelled' THEN 1 ELSE 0 END AS __cancelled_order_count\n    , CASE WHEN status = 'paid' THEN paid_cents - refund_cents ELSE 0 END AS __net_sales_cents\n  FROM \"data\".\"main\".\"orders_enriched\" orders_semantic_src_10000\n)\n\nSELECT\n  MAX(subq_11.valid_order_count) AS valid_order_count\n  , MAX(subq_11.net_sales_cents) AS net_sales_cents\n  , MAX(subq_19.avg_order_value) AS avg_order_value\n  , MAX(subq_19.cancel_rate) AS cancel_rate\nFROM (\n  SELECT\n    SUM(valid_order_count) AS valid_order_count\n    , SUM(net_sales_cents) AS net_sales_cents\n  FROM (\n    SELECT\n      order__status\n      , __valid_order_count AS valid_order_count\n      , __net_sales_cents AS net_sales_cents\n    FROM sma_10003_cte\n    WHERE metric_time__day BETWEEN '2026-08-01' AND '2026-08-31'\n  ) subq_7\n  WHERE order__status in ('cancelled')\n) subq_11\nCROSS JOIN (\n  SELECT\n    CAST(SUM(net_sales_cents) AS DOUBLE) / CAST(NULLIF(SUM(valid_order_count), 0) AS DOUBLE) AS avg_order_value\n    , CAST(SUM(cancelled_order_count) AS DOUBLE) / CAST(NULLIF(SUM(order_count), 0) AS DOUBLE) AS cancel_rate\n  FROM (\n    SELECT\n      order__status\n      , __order_count AS order_count\n      , __valid_order_count AS valid_order_count\n      , __cancelled_order_count AS cancelled_order_count\n      , __net_sales_cents AS net_sales_cents\n    FROM sma_10003_cte\n    WHERE metric_time__day BETWEEN '2026-08-01' AND '2026-08-31'\n  ) subq_14\n  WHERE order__status in ('cancelled')\n) subq_19",

  "sql": "WITH sma_10004_cte AS (\n  SELECT\n    DATE_TRUNC('day', ordered_at) AS metric_time__day\n    , status AS order__status\n    , CASE WHEN order_id IS NOT NULL THEN 1 ELSE 0 END AS __order_count\n    , CASE WHEN status = 'paid' THEN 1 ELSE 0 END AS __paid_order_count\n    , CASE WHEN status = 'paid' AND paid_cents - refund_cents > 0 THEN 1 ELSE 0 END AS __valid_order_count\n    , CASE WHEN status = 'cancelled' THEN 1 ELSE 0 END AS __cancelled_order_count\n    , CASE WHEN status = 'paid' AND refund_cents > 0 THEN 1 ELSE 0 END AS __refund_order_count\n    , CASE WHEN status = 'paid' AND refund_cents > 0 AND refund_cents < paid_cents THEN 1 ELSE 0 END AS __partial_refund_order_count\n    , CASE WHEN status = 'paid' AND paid_cents > 0 AND refund_cents = paid_cents THEN 1 ELSE 0 END AS __full_refund_order_count\n    , CASE WHEN status = 'paid' THEN paid_cents ELSE 0 END AS __payment_cents\n    , CASE WHEN status = 'paid' THEN refund_cents ELSE 0 END AS __refund_cents\n    , CASE WHEN status = 'paid' THEN paid_cents - refund_cents ELSE 0 END AS __net_sales_cents\n    , CASE WHEN status = 'paid' THEN gross_cents ELSE 0 END AS __gross_cents\n    , CASE WHEN status = 'paid' THEN gross_cents - paid_cents ELSE 0 END AS __discount_cents\n    , CASE WHEN status = 'paid' AND paid_cents - refund_cents > 0 THEN member_id END AS __buyer_count\n    , CASE WHEN status = 'paid' AND refund_cents > 0 THEN member_id END AS __refund_buyer_count\n    , CASE WHEN status = 'paid' AND paid_cents - refund_cents > 0 THEN store_id END AS __selling_store_count\n    , CASE WHEN status = 'paid' AND paid_cents - refund_cents > 0 THEN quantity ELSE 0 END AS __valid_order_items\n  FROM \"data\".\"main\".\"order_facts\" order_src_10000\n)\n\nSELECT\n  MAX(subq_23.order_count) AS order_count\n  , MAX(subq_23.paid_order_count) AS paid_order_count\n  , MAX(subq_23.valid_order_count) AS valid_order_count\n  , MAX(subq_23.cancelled_order_count) AS cancelled_order_count\n  , MAX(subq_23.refund_order_count) AS refund_order_count\n  , MAX(subq_23.partial_refund_order_count) AS partial_refund_order_count\n  , MAX(subq_23.full_refund_order_count) AS full_refund_order_count\n  , MAX(subq_23.payment_cents) AS payment_cents\n  , MAX(subq_23.refund_cents) AS refund_cents\n  , MAX(subq_23.net_sales_cents) AS net_sales_cents\n  , MAX(subq_23.gross_cents) AS gross_cents\n  , MAX(subq_23.discount_cents) AS discount_cents\n  , MAX(subq_23.buyer_count) AS buyer_count\n  , MAX(subq_23.refund_buyer_count) AS refund_buyer_count\n  , MAX(subq_23.selling_store_count) AS selling_store_count\n  , MAX(subq_23.valid_order_items) AS valid_order_items\n  , MAX(subq_31.avg_order_value) AS avg_order_value\n  , MAX(subq_31.avg_buyer_value) AS avg_buyer_value\n  , MAX(subq_31.purchase_frequency) AS purchase_frequency\n  , MAX(subq_31.refund_amount_rate) AS refund_amount_rate\n  , MAX(subq_31.cancel_rate) AS cancel_rate\n  , MAX(subq_31.refund_order_rate) AS refund_order_rate\n  , MAX(subq_31.discount_rate) AS discount_rate\n  , MAX(subq_31.items_per_order) AS items_per_order\nFROM (\n  SELECT\n    SUM(order_count) AS order_count\n    , SUM(paid_order_count) AS paid_order_count\n    , SUM(valid_order_count) AS valid_order_count\n    , SUM(cancelled_order_count) AS cancelled_order_count\n    , SUM(refund_order_count) AS refund_order_count\n    , SUM(partial_refund_order_count) AS partial_refund_order_count\n    , SUM(full_refund_order_count) AS full_refund_order_count\n    , SUM(payment_cents) AS payment_cents\n    , SUM(refund_cents) AS refund_cents\n    , SUM(net_sales_cents) AS net_sales_cents\n    , SUM(gross_cents) AS gross_cents\n    , SUM(discount_cents) AS discount_cents\n    , COUNT(DISTINCT buyer_count) AS buyer_count\n    , COUNT(DISTINCT refund_buyer_count) AS refund_buyer_count\n    , COUNT(DISTINCT selling_store_count) AS selling_store_count\n    , SUM(valid_order_items) AS valid_order_items\n  FROM (\n    SELECT\n      order__status\n      , __order_count AS order_count\n      , __paid_order_count AS paid_order_count\n      , __valid_order_count AS valid_order_count\n      , __cancelled_order_count AS cancelled_order_count\n      , __refund_order_count AS refund_order_count\n      , __partial_refund_order_count AS partial_refund_order_count\n      , __full_refund_order_count AS full_refund_order_count\n      , __payment_cents AS payment_cents\n      , __refund_cents AS refund_cents\n      , __net_sales_cents AS net_sales_cents\n      , __gross_cents AS gross_cents\n      , __discount_cents AS discount_cents\n      , __buyer_count AS buyer_count\n      , __refund_buyer_count AS refund_buyer_count\n      , __selling_store_count AS selling_store_count\n      , __valid_order_items AS valid_order_items\n    FROM sma_10004_cte\n    WHERE metric_time__day BETWEEN '2026-08-01' AND '2026-08-31'\n  ) subq_19\n  WHERE order__status in ('cancelled')\n) subq_23\nCROSS JOIN (\n  SELECT\n    CAST(SUM(net_sales_cents) AS DOUBLE) / CAST(NULLIF(SUM(valid_order_count), 0) AS DOUBLE) AS avg_order_value\n    , CAST(SUM(net_sales_cents) AS DOUBLE) / CAST(NULLIF(COUNT(DISTINCT buyer_count), 0) AS DOUBLE) AS avg_buyer_value\n    , CAST(SUM(valid_order_count) AS DOUBLE) / CAST(NULLIF(COUNT(DISTINCT buyer_count), 0) AS DOUBLE) AS purchase_frequency\n    , CAST(SUM(refund_cents) AS DOUBLE) / CAST(NULLIF(SUM(payment_cents), 0) AS DOUBLE) AS refund_amount_rate\n    , CAST(SUM(cancelled_order_count) AS DOUBLE) / CAST(NULLIF(SUM(order_count), 0) AS DOUBLE) AS cancel_rate\n    , CAST(SUM(refund_order_count) AS DOUBLE) / CAST(NULLIF(SUM(paid_order_count), 0) AS DOUBLE) AS refund_order_rate\n    , CAST(SUM(discount_cents) AS DOUBLE) / CAST(NULLIF(SUM(gross_cents), 0) AS DOUBLE) AS discount_rate\n    , CAST(SUM(valid_order_items) AS DOUBLE) / CAST(NULLIF(SUM(valid_order_count), 0) AS DOUBLE) AS items_per_order\n  FROM (\n    SELECT\n      order__status\n      , __order_count AS order_count\n      , __paid_order_count AS paid_order_count\n      , __valid_order_count AS valid_order_count\n      , __cancelled_order_count AS cancelled_order_count\n      , __refund_order_count AS refund_order_count\n      , __payment_cents AS payment_cents\n      , __refund_cents AS refund_cents\n      , __net_sales_cents AS net_sales_cents\n      , __gross_cents AS gross_cents\n      , __discount_cents AS discount_cents\n      , __buyer_count AS buyer_count\n      , __valid_order_items AS valid_order_items\n    FROM sma_10004_cte\n    WHERE metric_time__day BETWEEN '2026-08-01' AND '2026-08-31'\n  ) subq_26\n  WHERE order__status in ('cancelled')\n) subq_31",

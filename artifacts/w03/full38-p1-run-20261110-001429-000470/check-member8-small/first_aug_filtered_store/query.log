  "sql": "SELECT\n  COUNT(DISTINCT first_buyer_count) AS first_buyer_count\n  , SUM(first_order_sales_cents) AS first_order_sales_cents\n  , SUM(first_order_count) AS first_order_count\n  , SUM(repeat_order_count) AS repeat_order_count\nFROM (\n  SELECT\n    store_id AS store\n    , case when order_rank = 1 then member_id end AS first_buyer_count\n    , case when order_rank = 1 then net_sales_cents else 0 end AS first_order_sales_cents\n    , case when order_rank = 1 then 1 else 0 end AS first_order_count\n    , case when order_rank >= 2 then 1 else 0 end AS repeat_order_count\n  FROM \"data\".\"main\".\"valid_orders_sequenced\" order_history_semantic_src_10000\n  WHERE DATE_TRUNC('day', ordered_at) BETWEEN '2026-08-01' AND '2026-08-31'\n) subq_7\nWHERE store in ('S01')",

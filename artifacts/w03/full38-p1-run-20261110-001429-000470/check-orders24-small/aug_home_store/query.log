  "sql": "WITH sma_10005_cte AS (\n  SELECT\n    DATE_TRUNC('day', ordered_at) AS metric_time__day\n    , home_store_id AS home_store\n    , 1 AS __order_count\n    , case when status = 'paid' then 1 else 0 end AS __paid_order_count\n    , case when status = 'paid' and paid_cents - refund_cents > 0 then 1 else 0 end AS __valid_order_count\n    , case when status = 'cancelled' then 1 else 0 end AS __cancelled_order_count\n    , case when status = 'paid' and refund_cents > 0 then 1 else 0 end AS __refund_order_count\n    , case when status = 'paid' and refund_cents > 0 and refund_cents < paid_cents then 1 else 0 end AS __partial_refund_order_count\n    , case when status = 'paid' and paid_cents > 0 and refund_cents = paid_cents then 1 else 0 end AS __full_refund_order_count\n    , case when status = 'paid' then paid_cents else 0 end AS __payment_cents\n    , case when status = 'paid' then refund_cents else 0 end AS __refund_cents\n    , case when status = 'paid' then paid_cents - refund_cents else 0 end AS __net_sales_cents\n    , case when status = 'paid' then gross_cents else 0 end AS __gross_cents\n    , case when status = 'paid' then gross_cents - paid_cents else 0 end AS __discount_cents\n    , case when status = 'paid' and paid_cents - refund_cents > 0 then member_id end AS __buyer_count\n    , case when status = 'paid' and refund_cents > 0 then member_id end AS __refund_buyer_count\n    , case when status = 'paid' and paid_cents - refund_cents > 0 then store_id end AS __selling_store_count\n    , case when status = 'paid' and paid_cents - refund_cents > 0 then quantity else 0 end AS __valid_order_items\n  FROM \"data\".\"main\".\"orders_enriched\" order_semantic_src_10000\n)\n\nSELECT\n  COALESCE(subq_22.home_store, subq_28.home_store) AS home_store\n  , MAX(subq_22.order_count) AS order_count\n  , MAX(subq_22.paid_order_count) AS paid_order_count\n  , MAX(subq_22.valid_order_count) AS valid_order_count\n  , MAX(subq_22.cancelled_order_count) AS cancelled_order_count\n  , MAX(subq_22.refund_order_count) AS refund_order_count\n  , MAX(subq_22.partial_refund_order_count) AS partial_refund_order_count\n  , MAX(subq_22.full_refund_order_count) AS full_refund_order_count\n  , MAX(subq_22.payment_cents) AS payment_cents\n  , MAX(subq_22.refund_cents) AS refund_cents\n  , MAX(subq_22.net_sales_cents) AS net_sales_cents\n  , MAX(subq_22.gross_cents) AS gross_cents\n  , MAX(subq_22.discount_cents) AS discount_cents\n  , MAX(subq_22.buyer_count) AS buyer_count\n  , MAX(subq_22.refund_buyer_count) AS refund_buyer_count\n  , MAX(subq_22.selling_store_count) AS selling_store_count\n  , MAX(subq_22.valid_order_items) AS valid_order_items\n  , MAX(CAST(subq_28.net_sales_cents AS DOUBLE) / CAST(NULLIF(subq_28.valid_order_count, 0) AS DOUBLE)) AS avg_order_value\n  , MAX(CAST(subq_28.net_sales_cents AS DOUBLE) / CAST(NULLIF(subq_28.buyer_count, 0) AS DOUBLE)) AS avg_buyer_value\n  , MAX(CAST(subq_28.valid_order_count AS DOUBLE) / CAST(NULLIF(subq_28.buyer_count, 0) AS DOUBLE)) AS purchase_frequency\n  , MAX(CAST(subq_28.refund_cents AS DOUBLE) / CAST(NULLIF(subq_28.payment_cents, 0) AS DOUBLE)) AS refund_amount_rate\n  , MAX(CAST(subq_28.cancelled_order_count AS DOUBLE) / CAST(NULLIF(subq_28.order_count, 0) AS DOUBLE)) AS cancel_rate\n  , MAX(CAST(subq_28.refund_order_count AS DOUBLE) / CAST(NULLIF(subq_28.paid_order_count, 0) AS DOUBLE)) AS refund_order_rate\n  , MAX(CAST(subq_28.discount_cents AS DOUBLE) / CAST(NULLIF(subq_28.gross_cents, 0) AS DOUBLE)) AS discount_rate\n  , MAX(CAST(subq_28.valid_order_items AS DOUBLE) / CAST(NULLIF(subq_28.valid_order_count, 0) AS DOUBLE)) AS items_per_order\nFROM (\n  SELECT\n    home_store\n    , SUM(__order_count) AS order_count\n    , SUM(__paid_order_count) AS paid_order_count\n    , SUM(__valid_order_count) AS valid_order_count\n    , SUM(__cancelled_order_count) AS cancelled_order_count\n    , SUM(__refund_order_count) AS refund_order_count\n    , SUM(__partial_refund_order_count) AS partial_refund_order_count\n    , SUM(__full_refund_order_count) AS full_refund_order_count\n    , SUM(__payment_cents) AS payment_cents\n    , SUM(__refund_cents) AS refund_cents\n    , SUM(__net_sales_cents) AS net_sales_cents\n    , SUM(__gross_cents) AS gross_cents\n    , SUM(__discount_cents) AS discount_cents\n    , COUNT(DISTINCT __buyer_count) AS buyer_count\n    , COUNT(DISTINCT __refund_buyer_count) AS refund_buyer_count\n    , COUNT(DISTINCT __selling_store_count) AS selling_store_count\n    , SUM(__valid_order_items) AS valid_order_items\n  FROM sma_10005_cte\n  WHERE metric_time__day BETWEEN '2026-08-01' AND '2026-08-31'\n  GROUP BY\n    home_store\n) subq_22\nFULL OUTER JOIN (\n  SELECT\n    home_store\n    , SUM(__net_sales_cents) AS net_sales_cents\n    , SUM(__valid_order_count) AS valid_order_count\n    , COUNT(DISTINCT __buyer_count) AS buyer_count\n    , SUM(__refund_cents) AS refund_cents\n    , SUM(__payment_cents) AS payment_cents\n    , SUM(__cancelled_order_count) AS cancelled_order_count\n    , SUM(__order_count) AS order_count\n    , SUM(__refund_order_count) AS refund_order_count\n    , SUM(__paid_order_count) AS paid_order_count\n    , SUM(__discount_cents) AS discount_cents\n    , SUM(__gross_cents) AS gross_cents\n    , SUM(__valid_order_items) AS valid_order_items\n  FROM sma_10005_cte\n  WHERE metric_time__day BETWEEN '2026-08-01' AND '2026-08-31'\n  GROUP BY\n    home_store\n) subq_28\nON\n  subq_22.home_store = subq_28.home_store\nGROUP BY\n  COALESCE(subq_22.home_store, subq_28.home_store)",

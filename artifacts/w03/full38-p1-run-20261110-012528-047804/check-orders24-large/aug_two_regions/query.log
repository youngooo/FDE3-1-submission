  "sql": "WITH sma_10004_cte AS (\n  SELECT\n    DATE_TRUNC('day', ordered_at) AS metric_time__day\n    , store_id AS store\n    , home_store_id AS home_store\n    , 1 AS __order_count\n    , CASE WHEN status = 'paid' THEN 1 ELSE 0 END AS __paid_order_count\n    , CASE WHEN status = 'paid' AND paid_cents - refund_cents > 0 THEN 1 ELSE 0 END AS __valid_order_count\n    , CASE WHEN status = 'cancelled' THEN 1 ELSE 0 END AS __cancelled_order_count\n    , CASE WHEN status = 'paid' AND refund_cents > 0 THEN 1 ELSE 0 END AS __refund_order_count\n    , CASE WHEN status = 'paid' AND refund_cents > 0 AND refund_cents < paid_cents THEN 1 ELSE 0 END AS __partial_refund_order_count\n    , CASE WHEN status = 'paid' AND paid_cents > 0 AND refund_cents = paid_cents THEN 1 ELSE 0 END AS __full_refund_order_count\n    , CASE WHEN status = 'paid' THEN paid_cents ELSE 0 END AS __payment_cents\n    , CASE WHEN status = 'paid' THEN refund_cents ELSE 0 END AS __refund_cents\n    , CASE WHEN status = 'paid' THEN paid_cents - refund_cents ELSE 0 END AS __net_sales_cents\n    , CASE WHEN status = 'paid' THEN gross_cents ELSE 0 END AS __gross_cents\n    , CASE WHEN status = 'paid' THEN gross_cents - paid_cents ELSE 0 END AS __discount_cents\n    , CASE WHEN status = 'paid' AND paid_cents - refund_cents > 0 THEN member_id ELSE NULL END AS __buyer_count\n    , CASE WHEN status = 'paid' AND refund_cents > 0 THEN member_id ELSE NULL END AS __refund_buyer_count\n    , CASE WHEN status = 'paid' AND paid_cents - refund_cents > 0 THEN store_id ELSE NULL END AS __selling_store_count\n    , CASE WHEN status = 'paid' AND paid_cents - refund_cents > 0 THEN quantity ELSE 0 END AS __valid_order_items\n  FROM \"data\".\"main\".\"order_fact\" order_model_src_10000\n)\n\n, rss_10001_cte AS (\n  SELECT\n    region\n    , store_id AS home_store\n  FROM \"data\".\"main\".\"home_store_dim\" home_store_model_src_10000\n)\n\n, rss_10006_cte AS (\n  SELECT\n    region\n    , store_id AS store\n  FROM \"data\".\"main\".\"selling_store_dim\" selling_store_model_src_10000\n)\n\nSELECT\n  COALESCE(subq_27.home_store__region, subq_38.home_store__region) AS home_store__region\n  , COALESCE(subq_27.store__region, subq_38.store__region) AS store__region\n  , MAX(subq_27.order_count) AS order_count\n  , MAX(subq_27.paid_order_count) AS paid_order_count\n  , MAX(subq_27.valid_order_count) AS valid_order_count\n  , MAX(subq_27.cancelled_order_count) AS cancelled_order_count\n  , MAX(subq_27.refund_order_count) AS refund_order_count\n  , MAX(subq_27.partial_refund_order_count) AS partial_refund_order_count\n  , MAX(subq_27.full_refund_order_count) AS full_refund_order_count\n  , MAX(subq_27.payment_cents) AS payment_cents\n  , MAX(subq_27.refund_cents) AS refund_cents\n  , MAX(subq_27.net_sales_cents) AS net_sales_cents\n  , MAX(subq_27.gross_cents) AS gross_cents\n  , MAX(subq_27.discount_cents) AS discount_cents\n  , MAX(subq_27.buyer_count) AS buyer_count\n  , MAX(subq_27.refund_buyer_count) AS refund_buyer_count\n  , MAX(subq_27.selling_store_count) AS selling_store_count\n  , MAX(subq_27.valid_order_items) AS valid_order_items\n  , MAX(CAST(subq_38.net_sales_cents AS DOUBLE) / CAST(NULLIF(subq_38.valid_order_count, 0) AS DOUBLE)) AS avg_order_value\n  , MAX(CAST(subq_38.net_sales_cents AS DOUBLE) / CAST(NULLIF(subq_38.buyer_count, 0) AS DOUBLE)) AS avg_buyer_value\n  , MAX(CAST(subq_38.valid_order_count AS DOUBLE) / CAST(NULLIF(subq_38.buyer_count, 0) AS DOUBLE)) AS purchase_frequency\n  , MAX(CAST(subq_38.refund_cents AS DOUBLE) / CAST(NULLIF(subq_38.payment_cents, 0) AS DOUBLE)) AS refund_amount_rate\n  , MAX(CAST(subq_38.cancelled_order_count AS DOUBLE) / CAST(NULLIF(subq_38.order_count, 0) AS DOUBLE)) AS cancel_rate\n  , MAX(CAST(subq_38.refund_order_count AS DOUBLE) / CAST(NULLIF(subq_38.paid_order_count, 0) AS DOUBLE)) AS refund_order_rate\n  , MAX(CAST(subq_38.discount_cents AS DOUBLE) / CAST(NULLIF(subq_38.gross_cents, 0) AS DOUBLE)) AS discount_rate\n  , MAX(CAST(subq_38.valid_order_items AS DOUBLE) / CAST(NULLIF(subq_38.valid_order_count, 0) AS DOUBLE)) AS items_per_order\nFROM (\n  SELECT\n    rss_10001_cte.region AS home_store__region\n    , rss_10006_cte.region AS store__region\n    , SUM(subq_18.__order_count) AS order_count\n    , SUM(subq_18.__paid_order_count) AS paid_order_count\n    , SUM(subq_18.__valid_order_count) AS valid_order_count\n    , SUM(subq_18.__cancelled_order_count) AS cancelled_order_count\n    , SUM(subq_18.__refund_order_count) AS refund_order_count\n    , SUM(subq_18.__partial_refund_order_count) AS partial_refund_order_count\n    , SUM(subq_18.__full_refund_order_count) AS full_refund_order_count\n    , SUM(subq_18.__payment_cents) AS payment_cents\n    , SUM(subq_18.__refund_cents) AS refund_cents\n    , SUM(subq_18.__net_sales_cents) AS net_sales_cents\n    , SUM(subq_18.__gross_cents) AS gross_cents\n    , SUM(subq_18.__discount_cents) AS discount_cents\n    , COUNT(DISTINCT subq_18.__buyer_count) AS buyer_count\n    , COUNT(DISTINCT subq_18.__refund_buyer_count) AS refund_buyer_count\n    , COUNT(DISTINCT subq_18.__selling_store_count) AS selling_store_count\n    , SUM(subq_18.__valid_order_items) AS valid_order_items\n  FROM (\n    SELECT\n      store\n      , home_store\n      , __order_count\n      , __paid_order_count\n      , __valid_order_count\n      , __cancelled_order_count\n      , __refund_order_count\n      , __partial_refund_order_count\n      , __full_refund_order_count\n      , __payment_cents\n      , __refund_cents\n      , __net_sales_cents\n      , __gross_cents\n      , __discount_cents\n      , __buyer_count\n      , __refund_buyer_count\n      , __selling_store_count\n      , __valid_order_items\n    FROM sma_10004_cte\n    WHERE metric_time__day BETWEEN '2026-08-01' AND '2026-08-31'\n  ) subq_18\n  LEFT OUTER JOIN\n    rss_10001_cte\n  ON\n    subq_18.home_store = rss_10001_cte.home_store\n  LEFT OUTER JOIN\n    rss_10006_cte\n  ON\n    subq_18.store = rss_10006_cte.store\n  GROUP BY\n    rss_10001_cte.region\n    , rss_10006_cte.region\n) subq_27\nFULL OUTER JOIN (\n  SELECT\n    rss_10001_cte.region AS home_store__region\n    , rss_10006_cte.region AS store__region\n    , SUM(subq_29.__net_sales_cents) AS net_sales_cents\n    , SUM(subq_29.__valid_order_count) AS valid_order_count\n    , COUNT(DISTINCT subq_29.__buyer_count) AS buyer_count\n    , SUM(subq_29.__refund_cents) AS refund_cents\n    , SUM(subq_29.__payment_cents) AS payment_cents\n    , SUM(subq_29.__cancelled_order_count) AS cancelled_order_count\n    , SUM(subq_29.__order_count) AS order_count\n    , SUM(subq_29.__refund_order_count) AS refund_order_count\n    , SUM(subq_29.__paid_order_count) AS paid_order_count\n    , SUM(subq_29.__discount_cents) AS discount_cents\n    , SUM(subq_29.__gross_cents) AS gross_cents\n    , SUM(subq_29.__valid_order_items) AS valid_order_items\n  FROM (\n    SELECT\n      store\n      , home_store\n      , __order_count\n      , __paid_order_count\n      , __valid_order_count\n      , __cancelled_order_count\n      , __refund_order_count\n      , __payment_cents\n      , __refund_cents\n      , __net_sales_cents\n      , __gross_cents\n      , __discount_cents\n      , __buyer_count\n      , __valid_order_items\n    FROM sma_10004_cte\n    WHERE metric_time__day BETWEEN '2026-08-01' AND '2026-08-31'\n  ) subq_29\n  LEFT OUTER JOIN\n    rss_10001_cte\n  ON\n    subq_29.home_store = rss_10001_cte.home_store\n  LEFT OUTER JOIN\n    rss_10006_cte\n  ON\n    subq_29.store = rss_10006_cte.store\n  GROUP BY\n    rss_10001_cte.region\n    , rss_10006_cte.region\n) subq_38\nON\n  (\n    subq_27.home_store__region = subq_38.home_store__region\n  ) AND (\n    subq_27.store__region = subq_38.store__region\n  )\nGROUP BY\n  COALESCE(subq_27.home_store__region, subq_38.home_store__region)\n  , COALESCE(subq_27.store__region, subq_38.store__region)",

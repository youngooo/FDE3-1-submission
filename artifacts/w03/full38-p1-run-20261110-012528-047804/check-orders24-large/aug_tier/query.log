  "sql": "WITH sma_10004_cte AS (\n  SELECT\n    DATE_TRUNC('day', ordered_at) AS metric_time__day\n    , member_id AS member\n    , 1 AS __order_count\n    , CASE WHEN status = 'paid' THEN 1 ELSE 0 END AS __paid_order_count\n    , CASE WHEN status = 'paid' AND paid_cents - refund_cents > 0 THEN 1 ELSE 0 END AS __valid_order_count\n    , CASE WHEN status = 'cancelled' THEN 1 ELSE 0 END AS __cancelled_order_count\n    , CASE WHEN status = 'paid' AND refund_cents > 0 THEN 1 ELSE 0 END AS __refund_order_count\n    , CASE WHEN status = 'paid' AND refund_cents > 0 AND refund_cents < paid_cents THEN 1 ELSE 0 END AS __partial_refund_order_count\n    , CASE WHEN status = 'paid' AND paid_cents > 0 AND refund_cents = paid_cents THEN 1 ELSE 0 END AS __full_refund_order_count\n    , CASE WHEN status = 'paid' THEN paid_cents ELSE 0 END AS __payment_cents\n    , CASE WHEN status = 'paid' THEN refund_cents ELSE 0 END AS __refund_cents\n    , CASE WHEN status = 'paid' THEN paid_cents - refund_cents ELSE 0 END AS __net_sales_cents\n    , CASE WHEN status = 'paid' THEN gross_cents ELSE 0 END AS __gross_cents\n    , CASE WHEN status = 'paid' THEN gross_cents - paid_cents ELSE 0 END AS __discount_cents\n    , CASE WHEN status = 'paid' AND paid_cents - refund_cents > 0 THEN member_id ELSE NULL END AS __buyer_count\n    , CASE WHEN status = 'paid' AND refund_cents > 0 THEN member_id ELSE NULL END AS __refund_buyer_count\n    , CASE WHEN status = 'paid' AND paid_cents - refund_cents > 0 THEN store_id ELSE NULL END AS __selling_store_count\n    , CASE WHEN status = 'paid' AND paid_cents - refund_cents > 0 THEN quantity ELSE 0 END AS __valid_order_items\n  FROM \"data\".\"main\".\"order_fact\" order_model_src_10000\n)\n\n, sma_10001_cte AS (\n  SELECT\n    member_id AS member\n    , tier\n  FROM \"data\".\"main\".\"members\" member_model_src_10000\n)\n\nSELECT\n  COALESCE(subq_26.member__tier, subq_35.member__tier) AS member__tier\n  , MAX(subq_26.order_count) AS order_count\n  , MAX(subq_26.paid_order_count) AS paid_order_count\n  , MAX(subq_26.valid_order_count) AS valid_order_count\n  , MAX(subq_26.cancelled_order_count) AS cancelled_order_count\n  , MAX(subq_26.refund_order_count) AS refund_order_count\n  , MAX(subq_26.partial_refund_order_count) AS partial_refund_order_count\n  , MAX(subq_26.full_refund_order_count) AS full_refund_order_count\n  , MAX(subq_26.payment_cents) AS payment_cents\n  , MAX(subq_26.refund_cents) AS refund_cents\n  , MAX(subq_26.net_sales_cents) AS net_sales_cents\n  , MAX(subq_26.gross_cents) AS gross_cents\n  , MAX(subq_26.discount_cents) AS discount_cents\n  , MAX(subq_26.buyer_count) AS buyer_count\n  , MAX(subq_26.refund_buyer_count) AS refund_buyer_count\n  , MAX(subq_26.selling_store_count) AS selling_store_count\n  , MAX(subq_26.valid_order_items) AS valid_order_items\n  , MAX(CAST(subq_35.net_sales_cents AS DOUBLE) / CAST(NULLIF(subq_35.valid_order_count, 0) AS DOUBLE)) AS avg_order_value\n  , MAX(CAST(subq_35.net_sales_cents AS DOUBLE) / CAST(NULLIF(subq_35.buyer_count, 0) AS DOUBLE)) AS avg_buyer_value\n  , MAX(CAST(subq_35.valid_order_count AS DOUBLE) / CAST(NULLIF(subq_35.buyer_count, 0) AS DOUBLE)) AS purchase_frequency\n  , MAX(CAST(subq_35.refund_cents AS DOUBLE) / CAST(NULLIF(subq_35.payment_cents, 0) AS DOUBLE)) AS refund_amount_rate\n  , MAX(CAST(subq_35.cancelled_order_count AS DOUBLE) / CAST(NULLIF(subq_35.order_count, 0) AS DOUBLE)) AS cancel_rate\n  , MAX(CAST(subq_35.refund_order_count AS DOUBLE) / CAST(NULLIF(subq_35.paid_order_count, 0) AS DOUBLE)) AS refund_order_rate\n  , MAX(CAST(subq_35.discount_cents AS DOUBLE) / CAST(NULLIF(subq_35.gross_cents, 0) AS DOUBLE)) AS discount_rate\n  , MAX(CAST(subq_35.valid_order_items AS DOUBLE) / CAST(NULLIF(subq_35.valid_order_count, 0) AS DOUBLE)) AS items_per_order\nFROM (\n  SELECT\n    sma_10001_cte.tier AS member__tier\n    , SUM(subq_18.__order_count) AS order_count\n    , SUM(subq_18.__paid_order_count) AS paid_order_count\n    , SUM(subq_18.__valid_order_count) AS valid_order_count\n    , SUM(subq_18.__cancelled_order_count) AS cancelled_order_count\n    , SUM(subq_18.__refund_order_count) AS refund_order_count\n    , SUM(subq_18.__partial_refund_order_count) AS partial_refund_order_count\n    , SUM(subq_18.__full_refund_order_count) AS full_refund_order_count\n    , SUM(subq_18.__payment_cents) AS payment_cents\n    , SUM(subq_18.__refund_cents) AS refund_cents\n    , SUM(subq_18.__net_sales_cents) AS net_sales_cents\n    , SUM(subq_18.__gross_cents) AS gross_cents\n    , SUM(subq_18.__discount_cents) AS discount_cents\n    , COUNT(DISTINCT subq_18.__buyer_count) AS buyer_count\n    , COUNT(DISTINCT subq_18.__refund_buyer_count) AS refund_buyer_count\n    , COUNT(DISTINCT subq_18.__selling_store_count) AS selling_store_count\n    , SUM(subq_18.__valid_order_items) AS valid_order_items\n  FROM (\n    SELECT\n      member\n      , __order_count\n      , __paid_order_count\n      , __valid_order_count\n      , __cancelled_order_count\n      , __refund_order_count\n      , __partial_refund_order_count\n      , __full_refund_order_count\n      , __payment_cents\n      , __refund_cents\n      , __net_sales_cents\n      , __gross_cents\n      , __discount_cents\n      , __buyer_count\n      , __refund_buyer_count\n      , __selling_store_count\n      , __valid_order_items\n    FROM sma_10004_cte\n    WHERE metric_time__day BETWEEN '2026-08-01' AND '2026-08-31'\n  ) subq_18\n  LEFT OUTER JOIN\n    sma_10001_cte\n  ON\n    subq_18.member = sma_10001_cte.member\n  GROUP BY\n    sma_10001_cte.tier\n) subq_26\nFULL OUTER JOIN (\n  SELECT\n    sma_10001_cte.tier AS member__tier\n    , SUM(subq_28.__net_sales_cents) AS net_sales_cents\n    , SUM(subq_28.__valid_order_count) AS valid_order_count\n    , COUNT(DISTINCT subq_28.__buyer_count) AS buyer_count\n    , SUM(subq_28.__refund_cents) AS refund_cents\n    , SUM(subq_28.__payment_cents) AS payment_cents\n    , SUM(subq_28.__cancelled_order_count) AS cancelled_order_count\n    , SUM(subq_28.__order_count) AS order_count\n    , SUM(subq_28.__refund_order_count) AS refund_order_count\n    , SUM(subq_28.__paid_order_count) AS paid_order_count\n    , SUM(subq_28.__discount_cents) AS discount_cents\n    , SUM(subq_28.__gross_cents) AS gross_cents\n    , SUM(subq_28.__valid_order_items) AS valid_order_items\n  FROM (\n    SELECT\n      member\n      , __order_count\n      , __paid_order_count\n      , __valid_order_count\n      , __cancelled_order_count\n      , __refund_order_count\n      , __payment_cents\n      , __refund_cents\n      , __net_sales_cents\n      , __gross_cents\n      , __discount_cents\n      , __buyer_count\n      , __valid_order_items\n    FROM sma_10004_cte\n    WHERE metric_time__day BETWEEN '2026-08-01' AND '2026-08-31'\n  ) subq_28\n  LEFT OUTER JOIN\n    sma_10001_cte\n  ON\n    subq_28.member = sma_10001_cte.member\n  GROUP BY\n    sma_10001_cte.tier\n) subq_35\nON\n  subq_26.member__tier = subq_35.member__tier\nGROUP BY\n  COALESCE(subq_26.member__tier, subq_35.member__tier)",

  "sql": "SELECT\n  store_src_10000.region AS store__region\n  , subq_73.home_store__region AS member__home_store__region\n  , SUM(subq_66.__order_count) AS order_count\n  , SUM(subq_66.__paid_order_count) AS paid_order_count\n  , SUM(subq_66.__valid_order_count) AS valid_order_count\n  , SUM(subq_66.__cancelled_order_count) AS cancelled_order_count\n  , SUM(subq_66.__refund_order_count) AS refund_order_count\n  , SUM(subq_66.__partial_refund_order_count) AS partial_refund_order_count\n  , SUM(subq_66.__full_refund_order_count) AS full_refund_order_count\n  , SUM(subq_66.__payment_cents) AS payment_cents\n  , SUM(subq_66.__refund_cents) AS refund_cents\n  , SUM(subq_66.__net_sales_cents) AS net_sales_cents\n  , SUM(subq_66.__gross_cents) AS gross_cents\n  , SUM(subq_66.__discount_cents) AS discount_cents\n  , COUNT(DISTINCT subq_66.__buyer_count) AS buyer_count\n  , COUNT(DISTINCT subq_66.__refund_buyer_count) AS refund_buyer_count\n  , COUNT(DISTINCT subq_66.__selling_store_count) AS selling_store_count\n  , SUM(subq_66.__valid_order_items) AS valid_order_items\nFROM (\n  SELECT\n    member_id AS member\n    , store_id AS store\n    , 1 AS __order_count\n    , CASE WHEN status = 'paid' THEN 1 ELSE 0 END AS __paid_order_count\n    , CASE WHEN status = 'paid' AND paid_cents - refund_cents > 0 THEN 1 ELSE 0 END AS __valid_order_count\n    , CASE WHEN status = 'cancelled' THEN 1 ELSE 0 END AS __cancelled_order_count\n    , CASE WHEN status = 'paid' AND refund_cents > 0 THEN 1 ELSE 0 END AS __refund_order_count\n    , CASE WHEN status = 'paid' AND refund_cents > 0 AND refund_cents < paid_cents THEN 1 ELSE 0 END AS __partial_refund_order_count\n    , CASE WHEN status = 'paid' AND paid_cents > 0 AND refund_cents = paid_cents THEN 1 ELSE 0 END AS __full_refund_order_count\n    , CASE WHEN status = 'paid' THEN paid_cents ELSE 0 END AS __payment_cents\n    , CASE WHEN status = 'paid' THEN refund_cents ELSE 0 END AS __refund_cents\n    , CASE WHEN status = 'paid' THEN paid_cents - refund_cents ELSE 0 END AS __net_sales_cents\n    , CASE WHEN status = 'paid' THEN gross_cents ELSE 0 END AS __gross_cents\n    , CASE WHEN status = 'paid' THEN gross_cents - paid_cents ELSE 0 END AS __discount_cents\n    , CASE WHEN status = 'paid' AND paid_cents - refund_cents > 0 THEN member_id END AS __buyer_count\n    , CASE WHEN status = 'paid' AND refund_cents > 0 THEN member_id END AS __refund_buyer_count\n    , CASE WHEN status = 'paid' AND paid_cents - refund_cents > 0 THEN store_id END AS __selling_store_count\n    , CASE WHEN status = 'paid' AND paid_cents - refund_cents > 0 THEN quantity ELSE 0 END AS __valid_order_items\n  FROM \"data\".\"main\".\"orders\" order_src_10000\n  WHERE DATE_TRUNC('day', ordered_at) BETWEEN '2026-08-01' AND '2026-08-31'\n) subq_66\nLEFT OUTER JOIN\n  \"data\".\"main\".\"store_locations\" store_src_10000\nON\n  subq_66.store = store_src_10000.store_id\nLEFT OUTER JOIN (\n  SELECT\n    member_src_10000.member_id AS member\n    , home_store_src_10000.region AS home_store__region\n  FROM \"data\".\"main\".\"members\" member_src_10000\n  LEFT OUTER JOIN\n    \"data\".\"main\".\"home_store_locations\" home_store_src_10000\n  ON\n    member_src_10000.home_store_id = home_store_src_10000.store_id\n) subq_73\nON\n  subq_66.member = subq_73.member\nGROUP BY\n  store_src_10000.region\n  , subq_73.home_store__region",
